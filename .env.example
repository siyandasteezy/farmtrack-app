# isibaya — environment variables
# Copy to `.env` for local `netlify dev`, and set the same keys in
# Netlify → Site settings → Environment variables for production.
# NEVER commit the real secret key.

# Yoco payments — R1,800/month subscription.
# Secret key (sk_test_… / sk_live_…): Yoco Business Portal →
#   Manage → Connect → Checkout API → "How to connect".
# Direct link: https://app.yoco.com/manage/yoco-connect/integration?name=checkout_api
# sk_live_ stays locked until you verify isibaya.smartpick.co.za under Verified Domains.
YOCO_SECRET_KEY=""

# Webhook signing secret (whsec_…). Yoco returns it ONCE, in the response to
# the call that registers the webhook — it cannot be read back afterwards, so
# save it there and then. See docs/yoco-webhook.md for the registration call.
# Without this, /.netlify/functions/yoco-webhook rejects every delivery.
YOCO_WEBHOOK_SECRET=""

# Public site origin used for Yoco success/cancel redirects and for building
# email confirmation links.
# Optional for Yoco — defaults to the request origin, so it works on any domain.
# Production: https://isibaya.smartpick.co.za   Local netlify dev: http://localhost:8888
APP_URL="https://isibaya.smartpick.co.za"

# ── Database (Neon Postgres) ────────────────────────────────────────────
# Create a project at neon.tech, then copy BOTH connection strings:
#   DATABASE_URL — the POOLED string (host contains "-pooler"), used at runtime
#   DIRECT_URL   — the DIRECT string, used by `prisma migrate deploy`
# Keep ?sslmode=require on both.
DATABASE_URL=""
DIRECT_URL=""

# ── Sessions ────────────────────────────────────────────────────────────
# Signing secret for the session JWT. Generate with: openssl rand -hex 32
# Changing this signs everyone out.
AUTH_SECRET=""

# ── Email (Resend) ──────────────────────────────────────────────────────
# Used for address confirmation and payment receipts.
# Key: resend.com → API Keys. The from-address domain must be verified with
# Resend before mail will send from it.
RESEND_API_KEY=""
MAIL_FROM="isibaya <no-reply@isibaya.smartpick.co.za>"
