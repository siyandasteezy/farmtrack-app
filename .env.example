# insimi — environment variables
# Copy to `.env` for local `netlify dev`, and set the same keys in
# Netlify → Site settings → Environment variables for production.
# NEVER commit the real secret key.

# Yoco payments — R1,800/month subscription.
# Secret key (sk_test_… / sk_live_…): Yoco Business Portal →
#   Manage → Connect → Checkout API → "How to connect".
# Direct link: https://app.yoco.com/manage/yoco-connect/integration?name=checkout_api
# sk_live_ stays locked until you verify insimi.smartpick.co.za under Verified Domains.
YOCO_SECRET_KEY=""

# Public site origin used for Yoco success/cancel redirects.
# Optional — defaults to the request origin, so it works on any domain.
# Production: https://insimi.smartpick.co.za   Local netlify dev: http://localhost:8888
APP_URL="https://insimi.smartpick.co.za"
