// isibaya — server-side data model.
//
// Everything is owned by a User and scoped by userId. The farm-data models
// mirror the shapes the app already uses in localStorage so the client-side
// records can be imported without reshaping them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (…-pooler.…neon.tech)
  directUrl = env("DIRECT_URL") // direct, used by `prisma migrate deploy`
}

// ── Identity & billing ──────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  farm          String   @default("")
  avatar        String?
  role          String   @default("Owner")
  emailVerified Boolean  @default(false)
  /// Which enterprises this farm runs: "livestock" and/or "crops". Controls
  /// which modules appear, never what data is kept — turning one off tidies
  /// the navigation and leaves every record in place.
  enterprises   String[] @default(["livestock"])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Billing. The trial starts at registration; each Yoco payment extends
  // subscriptionEndsAt by a month. Access is decided from these server-side,
  // never from anything the browser sends.
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  verifications EmailVerification[]
  payments      Payment[]
  animals       Animal[]
  healthRecords HealthRecord[]
  inspections   Inspection[]
  harvests      Harvest[]
  colonyEvents  ColonyEvent[]
  sensors       Sensor[]
  readings      ManualReading[]
  feedItems     FeedItem[]
  equipment     Equipment[]
  tickets       Ticket[]
  devices       Device[]
  zones         Zone[]
  plantings     Planting[]
  fieldOps      FieldOperation[]
  cropHarvests  CropHarvest[]
  farmProfile   FarmProfile?
  farmBoundary  FarmBoundary?
}

/// Single-use email confirmation link. Only the hash of the token is stored,
/// so a database leak does not hand out working confirmation links.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String // address being confirmed — may differ from User.email mid-change
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Payment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  yocoCheckoutId String    @unique
  amountCents    Int
  currency       String    @default("ZAR")
  status         String    @default("PENDING") // PENDING | PAID | FAILED
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// ── Livestock ───────────────────────────────────────────────────────────

/// One row per animal — or per hive, when species is "Bee".
model Animal {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag      String
  name     String?
  species  String
  breed    String?
  dob      DateTime?
  sex      String?
  weight   Float?
  location String?
  status   String?
  notes    String?

  // Hive-specific (species = "Bee")
  strength    String?
  queenStatus String?
  queenYear   String?
  queenColour String?

  // GPS tracker / hive sensor
  trackerDeviceId String?
  trackerBattery  Int?
  trackerLat      Float?
  trackerLng      Float?
  trackerLastSeen DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tags identify animals on a farm, so they must not repeat within one account.
  @@unique([userId, tag])
  @@index([userId, species])
}

model HealthRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  animalTag  String
  animalName String?
  type       String
  vet        String?
  status     String   @default("Completed")
  cost       Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

// ── Apiary ──────────────────────────────────────────────────────────────

model Inspection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  hiveTag      String
  inspector    String?
  queenSeen    String?
  broodPattern String?
  stores       String?
  temperament  String?
  varroaCount  Float?
  pests        String[] @default([])
  actions      String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@index([userId, hiveTag])
}

model Harvest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hiveTag   String
  product   String
  quantity  Float
  frames    Int?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, product])
}

model ColonyEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  hiveTag   String
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, hiveTag])
}

// ── Crops ───────────────────────────────────────────────────────────────

/// A crop growing in a place for a season — the atomic unit for crops, the
/// way an Animal is for livestock and a hive is for bees. Nobody tracks an
/// individual maize plant.
model Planting {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String
  crop            String
  variety         String?
  category        String // Grain | Vegetable | Fruit
  /// Free text rather than a Zone relation, so a planting can name a field
  /// that has not been drawn on the farm plan yet.
  location        String?
  areaHa          Float?
  /// True for orchards and vines: established once, harvested many seasons.
  /// False for annuals, which run plant -> harvest -> done.
  perennial       Boolean   @default(false)
  plantCount      Int?
  plantedAt       DateTime?
  expectedHarvest DateTime?
  status          String    @default("Growing") // Planned | Growing | Harvested | Failed | Removed
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, code])
  @@index([userId, status])
}

// ── Sensors & devices ───────────────────────────────────────────────────

model Sensor {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String    @default("Environment")
  icon         String?
  location     String?
  unit         String
  min          Float     @default(0)
  max          Float     @default(100)
  value        Float     @default(0)
  initialValue Float?
  status       String    @default("normal") // normal | warn | alert
  isManual     Boolean   @default(false)
  lastManualAt DateTime?
  isCustom     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  readings ManualReading[]
  devices  Device[]

  @@index([userId])
}

model ManualReading {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  sensorName String?
  location   String?
  unit       String?
  value      Float
  status     String?
  reason     String?
  notes      String?
  loggedAt   DateTime @default(now())

  @@index([userId, loggedAt])
  @@index([sensorId])
}

model Device {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId          String
  sensorId          String?
  sensor            Sensor?   @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  protocol          String    @default("MQTT")
  // Retrievable on purpose: the Sensors page redisplays it in the firmware
  // snippet long after setup. Scoped to the owning account.
  token             String?
  reportingInterval Int       @default(60)
  status            String    @default("pending") // pending | online | offline
  lastSeen          DateTime?
  createdAt         DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

// ── Feed, equipment, tickets ────────────────────────────────────────────

model FeedItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species      String
  type         String
  dailyPerHead Float
  stock        Float    @default(0)
  unit         String   @default("kg")
  costPerKg    Float    @default(0)
  daysLeft     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Equipment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String
  serial       String?
  location     String?
  status       String    @default("Active")
  purchaseDate DateTime?
  lastService  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  subCategory String?
  priority    String   @default("Medium")
  status      String   @default("Open")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

// ── Farm plan ───────────────────────────────────────────────────────────

model Zone {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("Paddock")
  color     String?
  border    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model FarmProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String @default("")
  address  String @default("")
  country  String @default("")
  area     String @default("")
  areaUnit String @default("ha")
  lat      Float?
  lng      Float?
}

model FarmBoundary {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String @default("circle") // circle | polygon
  lat    Float?
  lng    Float?
  radius Float?
  points Json? // polygon vertices when type = "polygon"
}

/// Anything done to a planting between going in the ground and coming off it.
///
/// Sprays are the reason this table exists. Agricultural remedies are
/// registered under Act 36 of 1947 and every label carries an L-number and a
/// withholding period; a packhouse, an export agent or a GLOBALG.A.P. auditor
/// can ask to see the record for any consignment.
model FieldOperation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date         DateTime
  /// The planting's code rather than a foreign key, matching how hive
  /// inspections reference a hive tag. Deleting a planting must not take its
  /// spray history with it — that record may still be asked for.
  plantingCode String
  /// Copied from the planting when the record is written, so the history still
  /// reads correctly if the planting is renamed or removed.
  crop         String?
  location     String?
  type         String // Spray | Fertiliser | Irrigation | Cultivation | Pruning | Scouting | Other

  // Product detail — sprays and fertilisers.
  product          String?
  activeIngredient String?
  /// L-number off the product label (Act 36 of 1947).
  registrationNo   String?
  /// Pest, disease, weed or nutrient the application is aimed at.
  target           String?
  /// Free text, because labels quote rates in incompatible ways:
  /// "1.5 L/ha", "200 mL/100 L", "35 g per tree".
  dose             String?
  totalQuantity    Float?
  quantityUnit     String?
  waterVolumeL     Float?

  /// Days between application and the earliest legal harvest, off the label.
  /// The whole point of the record: harvesting inside this window risks
  /// residues above the MRL.
  phiDays  Int?
  /// Hours before workers may re-enter the treated block.
  reiHours Int?

  operator   String?
  equipment  String?
  /// Spray drift is mostly a wind problem, so the speed is kept as a number.
  windKph    Float?
  conditions String?

  areaHa Float?
  cost   Float?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, plantingCode])
  @@index([userId, date])
}

/// What actually came off a planting. Separate from Harvest, which is the
/// apiary's honey and wax — the two share a word and nothing else.
model CropHarvest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date         DateTime
  /// By code, like FieldOperation, so a deleted planting does not take the
  /// yield history with it.
  plantingCode String
  crop         String?
  variety      String?
  location     String?

  /// Batch identifier that follows the produce off the farm. The thread a
  /// recall or a buyer query is pulled by, so it stays on the record even
  /// when nothing downstream uses it yet.
  lotCode String?

  quantity     Float
  unit         String  @default("kg")
  /// Class 1 / 2 / 3 per the Agricultural Product Standards Act 119 of 1990,
  /// or Processing / Reject / Ungraded.
  grade        String?
  /// Packhouse, market, co-op, buyer, or own use.
  destination  String?
  /// Rand per unit, so income follows from quantity rather than being typed
  /// twice and disagreeing with it.
  pricePerUnit Float?

  /// Area actually taken off, which is not always the whole planting —
  /// a block can be picked over several passes.
  areaHa   Float?
  operator String?
  notes    String?

  /// True when this was recorded inside a withholding period and confirmed
  /// anyway. Neither silently allowed nor hard-blocked: the farmer may be
  /// correcting a mistyped interval or harvesting for a different purpose,
  /// but an auditor should see that the exception was made deliberately.
  withholdingOverride Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, plantingCode])
  @@index([userId, date])
}
